{
  "name": "mathclass-network",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MathClass Network — a peer-led math study network at mathclass.uk",
  "homepage": "https://mathclass.uk",
  "scripts": {
    "predev": "npm run sync:games",
    "dev": "vite",
    "prebuild": "npm run sync:games",
    "build": "tsc --noEmit && vite build && node scripts/spa-fallback.mjs && node scripts/build-og.mjs",
    "preview": "vite preview",
    "pretypecheck": "npm run sync:games",
    "typecheck": "tsc --noEmit",
    "sync:games": "node scripts/sync-games.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
